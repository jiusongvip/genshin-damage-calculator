---
// Why us vs the incumbents — a transparent comparison table that builds trust
// and targets "best genshin damage calculator" / "genshin damage calculator
// alternatives" long-tail queries. Honest about where we do NOT win (full
// artifact optimization), which is itself a trust signal.
const rows = [
  { feature: 'Zero-input presets (pick a character → instant reference damage)', us: '✓', aspirine: '✗', optimizer: '✗', paimon: '✗' },
  { feature: 'Every value editable by hand (level, weapon, set, multiplier)', us: '✓', aspirine: '✗', optimizer: '~', paimon: '✓' },
  { feature: 'Weapon rankings computed by the engine (not text)', us: '✓', aspirine: '✗', optimizer: '✗', paimon: '~' },
  { feature: 'Constellation value tables (C1–C6 gain)', us: '✓', aspirine: '~', optimizer: '✗', paimon: '✗' },
  { feature: 'Artifact set & talent priority cheat sheets', us: '✓', aspirine: '✗', optimizer: '✗', paimon: '~' },
  { feature: 'Full artifact optimizer (scan → auto-best build)', us: '✗', aspirine: '✗', optimizer: '✓', paimon: '~' },
  { feature: 'No account, no manual sub-stat entry required', us: '✓', aspirine: '✗', optimizer: '✗', paimon: '✓' },
  { feature: 'Mobile-friendly responsive layout', us: '✓', aspirine: '✗', optimizer: '~', paimon: '✓' },
];

// The three states are drawn rather than typed: a glyph like ✓ or ✗ renders
// differently in every font (and can fall back to a tofu box), so the marks are
// inline SVG with a screen-reader label.
const MARK_LABEL: Record<string, string> = { '✓': 'Yes', '~': 'Partial', '✗': 'No' };

const mark = (v: string) => {
  const open =
    '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="inline-block align-middle">';
  const body =
    v === '✓'
      ? '<path d="M20 6L9 17l-5-5"/>'
      : v === '~'
        ? '<circle cx="12" cy="12" r="9"/><path d="M12 3a9 9 0 0 1 0 18" fill="currentColor" stroke="none"/>'
        : '<path d="M18 6L6 18M6 6l12 12"/>';
  return `${open}${body}</svg><span class="sr-only">${MARK_LABEL[v] ?? v}</span>`;
};

const markClass = (v: string) =>
  v === '✓' ? 'text-dendro' : v === '~' ? 'text-forest-600' : 'text-[var(--muted)]';
---

<section id="why-us" class="page-shell section-pad scroll-mt-20 border-t border-[var(--line)]">
  <h2 class="text-3xl font-semibold tracking-tight text-[var(--text)]">Why this calculator is different</h2>
  <p class="mt-3 max-w-[65ch] text-[var(--muted)]">
    The big three calculators (Aspirine, Genshin Optimizer, paimon.app) are all excellent — but they are built for
    hardcore optimizers who enjoy entering sub-stats. This tool optimizes for the other 90%: getting a trustworthy
    damage number and a clear next step in under 30 seconds.
  </p>

  <div class="panel mt-8 overflow-x-auto">
    <table class="w-full min-w-[640px] text-left text-sm">
      <thead>
        <tr class="border-b border-[var(--line)] text-[var(--muted)]">
          <th class="px-4 py-3 font-medium">Feature</th>
          <th class="px-3 py-3 text-center font-medium text-forest-600">This tool</th>
          <th class="px-3 py-3 text-center font-medium">Aspirine</th>
          <th class="px-3 py-3 text-center font-medium">Optimizer</th>
          <th class="px-3 py-3 text-center font-medium">paimon.app</th>
        </tr>
      </thead>
      <tbody>
        {rows.map((r) => (
          <tr class="border-b border-[var(--line)] last:border-b-0">
            <td class="px-4 py-2.5 text-[var(--text)]">{r.feature}</td>
            <td class={`px-3 py-2.5 text-center ${markClass(r.us)}`} set:html={mark(r.us)} />
            <td class={`px-3 py-2.5 text-center ${markClass(r.aspirine)}`} set:html={mark(r.aspirine)} />
            <td class={`px-3 py-2.5 text-center ${markClass(r.optimizer)}`} set:html={mark(r.optimizer)} />
            <td class={`px-3 py-2.5 text-center ${markClass(r.paimon)}`} set:html={mark(r.paimon)} />
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <div class="panel mt-6 border-forest-500/30 bg-forest-500/8 p-6">
    <h3 class="text-lg font-semibold text-forest-600">Honest note on what this is NOT</h3>
    <p class="mt-2 text-sm leading-relaxed text-[var(--muted)]">
      Genshin Optimizer is the better tool if you want to scan your entire artifact inventory and solve for the
      mathematically optimal set. This calculator does not do full inventory optimization — instead it answers the
      faster questions: "what can this character hit?", "which weapon is better?", "is that constellation worth it?",
      and "what should I level next?". Use both: this page for quick decisions, Optimizer for deep artifact solving.
    </p>
  </div>
</section>
