---
import { sectionHref } from '../lib/section-links';

const currentYear = new Date().getFullYear();

// The footer is on every page, but #calculator / #presets / #guide / #faq are
// homepage-only anchors. See src/lib/section-links.ts for why a bare hash here
// is a dead link on subpages.
const pathname = Astro.url.pathname;
---

<footer class="mt-auto border-t border-[var(--line)] bg-[#FFFBE7]">
  <div class="page-shell grid grid-cols-1 gap-10 py-12 md:grid-cols-2 lg:grid-cols-4">
    <div class="lg:col-span-1">
      <a href="/" class="text-lg font-semibold tracking-[-0.02em] text-[var(--text)]">
        Genshin Damage Calculator
      </a>
      <p class="mt-3 text-sm leading-relaxed text-[var(--muted)]">
        Free Genshin Impact damage calculator. Pick a preset or set every value yourself, compare weapons and artifacts, and see exactly how much damage you’ll deal — no signup required.
      </p>
    </div>

    <div>
      <h3 class="text-sm font-semibold text-[var(--text)]">Tools</h3>
      <ul class="mt-3 space-y-2">
        <li><a href={sectionHref('#calculator', pathname)} class="text-sm text-[var(--muted)] hover:text-forest-600">Damage Calculator</a></li>
        <li><a href={sectionHref('#presets', pathname)} class="text-sm text-[var(--muted)] hover:text-forest-600">Character Presets</a></li>
        <li><a href="/characters/" class="text-sm text-[var(--muted)] hover:text-forest-600">All Characters</a></li>
        <li><a href="/guides/damage-formula/" class="text-sm text-[var(--muted)] hover:text-forest-600">Damage Formula</a></li>
        <li><a href="/guides/builds/" class="text-sm text-[var(--muted)] hover:text-forest-600">Weapon Comparison</a></li>
      </ul>
    </div>

    <div>
      <h3 class="text-sm font-semibold text-[var(--text)]">Resources</h3>
      <ul class="mt-3 space-y-2">
        <li><a href={sectionHref('#guide', pathname)} class="text-sm text-[var(--muted)] hover:text-forest-600">How to Use</a></li>
        <li><a href="/guides/improve-damage/" class="text-sm text-[var(--muted)] hover:text-forest-600">Increase Damage</a></li>
        <li><a href="/guides/improve-damage/#mistakes" class="text-sm text-[var(--muted)] hover:text-forest-600">Common Mistakes</a></li>
        <li><a href="/guides/damage-formula/#reactions" class="text-sm text-[var(--muted)] hover:text-forest-600">Elemental Reactions</a></li>
        <li><a href={sectionHref('#faq', pathname)} class="text-sm text-[var(--muted)] hover:text-forest-600">FAQ</a></li>
        <li><a href="https://www.youtube.com/@GenshinImpact" target="_blank" rel="noopener" class="text-sm text-[var(--muted)] hover:text-forest-600">Official YouTube</a></li>
      </ul>
    </div>

    <div>
      <h3 class="text-sm font-semibold text-[var(--text)]">About</h3>
      <ul class="mt-3 space-y-2">
        <li><a href="/about/" class="text-sm text-[var(--muted)] hover:text-forest-600">About the project</a></li>
        <li><a href="/contact/" class="text-sm text-[var(--muted)] hover:text-forest-600">Contact</a></li>
        <li><a href="/privacy/" class="text-sm text-[var(--muted)] hover:text-forest-600">Privacy Policy</a></li>
        <li><a href="/terms/" class="text-sm text-[var(--muted)] hover:text-forest-600">Terms of Use</a></li>
      </ul>
      <p class="mt-3 text-xs leading-relaxed text-[var(--muted)]">
        Independent fan-made tool. Not affiliated with, endorsed by, or sponsored by HoYoverse, miHoYo, or Cognosphere. Genshin Impact and all related assets are property of their respective owners. Damage values are estimates from the official formula and may differ slightly from in-game rounding.
      </p>
    </div>
  </div>

  <div class="border-t border-[var(--line)]">
    <div class="page-shell flex flex-col gap-2 py-6 text-xs text-[var(--muted)] sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {currentYear} Genshin Damage Calculator. All rights reserved.</p>
      <p>Updated for Genshin Impact version 7.0 (Snezhnaya, Aug 12 2026).</p>
    </div>
  </div>
</footer>
