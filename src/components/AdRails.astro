---
/**
 * Left and right 160x600 ad rails in the page gutters (visible from 1280px).
 *
 * These are placeholders: each slot carries a data-ad-slot name so the real ad
 * tag can be dropped in without touching the layout. Positioning lives in
 * global.css (.ad-rail) because it has to track the .page-shell width.
 */
---

<aside class="ad-rail ad-rail--left" aria-label="Advertisement">
  <div class="ad-slot" data-ad-slot="rail-left-160x600">Ad · 160 × 600</div>
</aside>
<aside class="ad-rail ad-rail--right" aria-label="Advertisement">
  <div class="ad-slot" data-ad-slot="rail-right-160x600">Ad · 160 × 600</div>
</aside>
