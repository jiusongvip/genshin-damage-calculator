---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormulaSection from '../../components/FormulaSection.astro';
import ReactionsSection from '../../components/ReactionsSection.astro';

const title = 'Genshin Damage Formula Explained — ATK, CRIT & RES';
const description =
  'The full five-multiplier Genshin Impact damage formula: Base ATK × Skill Multiplier × DMG Bonus × CRIT × Reaction, with DEF and RES breakdowns.';
---

<BaseLayout title={title} description={description}>
  <section class="page-shell section-pad">
    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-forest-600">Guides · Mechanics</p>
    <h1 class="mt-2 font-display text-4xl font-semibold tracking-tight text-[var(--text)] md:text-5xl">
      The Genshin Impact damage formula, explained
    </h1>
    <p class="mt-5 max-w-[65ch] text-lg leading-relaxed text-[var(--muted)]">
      Every damage instance in Genshin Impact follows one multiplicative chain: Total ATK × Skill Multiplier ×
      (1 + DMG Bonus) × CRIT × Reaction, then scaled by enemy DEF and elemental RES. This guide walks through each
      multiplier with the exact coefficients the <a href="/"
      class="text-forest-600 underline underline-offset-4">damage calculator</a> uses.
    </p>
    <blockquote class="panel mt-8 max-w-[65ch] border-l-4 border-forest-500 p-6">
      <p class="leading-relaxed text-[var(--text)]">
        “When characters or enemies attack their targets, they deal damage (abbreviated as DMG) based on their own
        and their target’s attributes. … There are eight damage types: seven Elemental and one Physical.”
      </p>
      <cite class="mt-3 block text-sm not-italic text-[var(--muted)]">
        — <a href="https://genshin-impact.fandom.com/wiki/Damage" target="_blank" rel="noopener"
        class="text-forest-600 underline underline-offset-4">Genshin Impact Wiki</a>, “Damage” (community-maintained
        reference of the official combat system)
      </cite>
    </blockquote>
  </section>

  <FormulaSection />
  <ReactionsSection />

  <section class="page-shell section-pad border-t border-[var(--line)]">
    <h2 class="text-2xl font-semibold tracking-tight text-[var(--text)]">Put the formula to work</h2>
    <p class="mt-3 max-w-[65ch] text-[var(--muted)]">
      Model any build against the exact multipliers above in the free calculator — no signup, or import your UID to
      use your real artifacts.
    </p>
    <div class="mt-6 flex flex-wrap gap-3">
      <a href="/#calculator" class="rounded-xl bg-forest-300 px-6 py-3 text-sm font-semibold text-forest-900 transition-colors hover:bg-forest-200">Open the calculator</a>
      <a href="/guides/builds/" class="rounded-xl border border-[var(--line)] bg-white/50 px-6 py-3 text-sm font-semibold text-[var(--text)] transition-colors hover:border-forest-500">Weapon &amp; artifact builds</a>
      <a href="/guides/improve-damage/" class="rounded-xl border border-[var(--line)] bg-white/50 px-6 py-3 text-sm font-semibold text-[var(--text)] transition-colors hover:border-forest-500">How to increase damage</a>
    </div>
  </section>
</BaseLayout>
