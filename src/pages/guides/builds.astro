---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WeaponComparisonSection from '../../components/WeaponComparisonSection.astro';
import ArtifactSetsSection from '../../components/ArtifactSetsSection.astro';
import ConstellationsSection from '../../components/ConstellationsSection.astro';
import TalentPrioritySection from '../../components/TalentPrioritySection.astro';
import ComparisonSection from '../../components/ComparisonSection.astro';

const title = 'Genshin Character Build Guide — Weapons & Artifacts';
const description =
  'How to choose weapons, artifact sets, main stats, constellations, and talent priority for any Genshin Impact DPS — checked against the live damage formula.';
---

<BaseLayout title={title} description={description}>
  <section class="page-shell section-pad">
    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-forest-600">Guides · Builds</p>
    <h1 class="mt-2 font-display text-4xl font-semibold tracking-tight text-[var(--text)] md:text-5xl">
      Character builds: weapons, artifacts, talents &amp; constellations
    </h1>
    <p class="mt-5 max-w-[65ch] text-lg leading-relaxed text-[var(--muted)]">
      A Genshin build is four choices that feed the damage formula: weapon, artifact set, talent priority, and which
      constellations actually pay off. This guide ranks each option by computed damage impact rather than popularity,
      and every ranking is reproducible in the <a href="/"
      class="text-forest-600 underline underline-offset-4">damage calculator</a>.
    </p>
  </section>

  <WeaponComparisonSection />
  <ArtifactSetsSection />
  <ConstellationsSection />
  <TalentPrioritySection />
  <ComparisonSection />

  <section class="page-shell section-pad border-t border-[var(--line)]">
    <h2 class="text-2xl font-semibold tracking-tight text-[var(--text)]">Compare your own build</h2>
    <p class="mt-3 max-w-[65ch] text-[var(--muted)]">
      Load any character preset and swap weapons, artifacts and multipliers to see the exact damage
      difference before you spend resin.
    </p>
    <div class="mt-6 flex flex-wrap gap-3">
      <a href="/#calculator" class="rounded-xl bg-forest-300 px-6 py-3 text-sm font-semibold text-forest-900 transition-colors hover:bg-forest-200">Open the calculator</a>
      <a href="/guides/damage-formula/" class="rounded-xl border border-[var(--line)] bg-white/50 px-6 py-3 text-sm font-semibold text-[var(--text)] transition-colors hover:border-forest-500">Read the damage formula</a>
      <a href="/guides/improve-damage/" class="rounded-xl border border-[var(--line)] bg-white/50 px-6 py-3 text-sm font-semibold text-[var(--text)] transition-colors hover:border-forest-500">Fix what’s holding damage back</a>
    </div>
  </section>
</BaseLayout>
