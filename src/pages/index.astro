---
import BaseLayout from '../layouts/BaseLayout.astro';
import SingleCalculator from '../components/SingleCalculator.tsx';
import AdRails from '../components/AdRails.astro';
import { RELEASED_CHARACTERS } from '../data/characters';
import { getWeapon } from '../data/weapons';
import { ENEMIES } from '../data/enemies';
import { DEFAULT_BUFFS, NO_ARTIFACTS } from '../data/presets';
import { FAQS } from '../data/faqs';
import { FEATURED_CHARACTERS, OFFICIAL_VIDEOS, OFFICIAL_YOUTUBE } from '../data/media';
import { computeDamage, formatNumber, formatPercent } from '../lib/damage';
import type { ElementType } from '../lib/damage';

const siteURL = 'https://www.genshindamagecalculator.com';
const version = '7.0';

// Pre-compute each character’s preset damage so the numbers render in the
// initial HTML (static fallback + crawlable content, no JS required).
//
// Every row is computed WITHOUT a reaction. The table used to hand Pyro a free
// Vaporize and Cryo a free Melt while every other element got nothing, which
// made the numbers incomparable — a Cryo support outranked Raiden Shogun purely
// on a x1.5 nobody had chosen. Reactions are a team decision, so they belong in
// the calculator, not in a per-character reference number.
const enemy = ENEMIES[0];
const presetRows = RELEASED_CHARACTERS.map((c) => {
  const weapon = getWeapon(c.bestWeapon)!;
  const r = computeDamage({
    character: c,
    weapon,
    artifacts: NO_ARTIFACTS,
    buffs: DEFAULT_BUFFS,
    enemy,
    characterLevel: 90,
    amplified: 'none',
    transformative: 'none',
  });
  return { character: c, weapon, expected: r.expected, critRate: r.critRate, critDMG: r.critDMG };
});

// Group presets by element for a crawlable, per-element directory.
const ELEMENT_ORDER: ElementType[] = ['pyro', 'hydro', 'electro', 'cryo', 'anemo', 'geo', 'dendro'];
const presetByElement = ELEMENT_ORDER.map((el) => ({
  element: el,
  rows: presetRows.filter((r) => r.character.element === el),
})).filter((g) => g.rows.length > 0);

const ELEMENT_LABEL: Record<ElementType, string> = {
  pyro: 'Pyro',
  hydro: 'Hydro',
  electro: 'Electro',
  cryo: 'Cryo',
  anemo: 'Anemo',
  geo: 'Geo',
  dendro: 'Dendro',
  physical: 'Physical',
};
const title = 'Genshin Damage Calculator — Free & Accurate (Updated 7.0)';
const description =
  'Free Genshin Impact damage calculator for every character. Edit the six damage multipliers — base, DMG bonus, CRIT, reaction, DEF and RES — and see exactly how each one changes the final number. Character + weapon, with optional artifact stats.';

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Genshin Damage Calculator',
    url: siteURL,
    applicationCategory: 'GameApplication',
    operatingSystem: 'Any',
    softwareVersion: version,
    dateModified: new Date().toISOString().slice(0, 10),
    description,
    author: { '@type': 'Person', name: 'Kai Ren', jobTitle: 'Independent developer', url: siteURL },
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    featureList: [
      'Zero-input character presets: level 90, best weapon',
      'Optional artifact main stats and sub-stats',
      'Six damage multipliers, each independently editable',
      'Live formula chain and per-zone contribution breakdown',
      'Shareable URL state',
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Genshin Impact character damage reference panels',
    numberOfItems: RELEASED_CHARACTERS.length,
    itemListElement: RELEASED_CHARACTERS.map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: `${c.name} damage reference`,
      description: c.note,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: FAQS.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: 'Kai Ren',
    jobTitle: 'Independent developer',
    url: siteURL,
    description: 'Independent developer and long-time Genshin Impact player. Maintains the calculator data against the live game and cross-checks multipliers against the official damage formula.',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'VideoGame',
    name: 'Genshin Impact',
    url: 'https://genshin.hoyoverse.com/',
    gamePlatform: ['Windows', 'PlayStation 4', 'PlayStation 5', 'iOS', 'Android'],
    applicationCategory: 'Game',
    publisher: { '@type': 'Organization', name: 'HoYoverse' },
    description: 'Open-world action RPG by HoYoverse. This calculator models its official damage formula.',
  },
];
---

<BaseLayout title={title} description={description} schema={schema}>
  <AdRails />

  <!-- ============ Hero ============ -->
  <!-- Title and four badges only: everything else moved out so the character
       roster is visible on the first screen. -->
  <section class="relative overflow-hidden border-b border-[var(--line)]">
    <div class="absolute inset-0 bg-linear-to-br from-forest-500/[0.08] via-transparent to-forest-200/[0.45]" aria-hidden="true"></div>
    <div class="page-shell relative py-5 text-center md:py-7">
      <h1 class="text-xl font-semibold tracking-tight text-[var(--text)] sm:text-2xl md:text-3xl">
        Genshin Damage Calculator
      </h1>
      <ul class="mt-3 flex flex-wrap items-center justify-center gap-2" aria-label="Calculator highlights">
        <li class="rounded-full border border-forest-500/30 bg-white/70 px-3 py-1 text-xs font-semibold text-forest-700 md:text-sm">Free</li>
        <li class="rounded-full border border-forest-500/30 bg-white/70 px-3 py-1 text-xs font-semibold text-forest-700 md:text-sm">No signup</li>
        <li class="rounded-full border border-forest-500/30 bg-white/70 px-3 py-1 text-xs font-semibold text-forest-700 md:text-sm">All {RELEASED_CHARACTERS.length} characters</li>
        <li class="rounded-full bg-forest-600 px-3 py-1 text-xs font-semibold text-white md:text-sm">Data snapshot v{version}</li>
      </ul>
    </div>
  </section>

  <!-- ============ Calculator ============ -->
  <section id="calculator" class="page-shell scroll-mt-4 py-5 md:py-6">
    <div class="mb-3 flex justify-end">
      <a href="#guide" class="hidden text-sm text-forest-600 underline decoration-forest-500/50 underline-offset-2 sm:inline">How to use it</a>
    </div>
    <SingleCalculator client:load />
  </section>

  <!-- ============ Formula (compact) ============ -->
  <section id="formula" class="page-shell section-pad scroll-mt-20 border-t border-[var(--line)]">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-forest-600">The math</p>
        <h2 class="mt-2 text-3xl font-semibold tracking-tight text-[var(--text)]">How Genshin damage is calculated</h2>
        <p class="mt-3 max-w-[65ch] text-[var(--muted)]">
          Every number above is one product of six factors — the official damage formula, following KeqingMains theorycrafting.
        </p>
      </div>
      <a href="/how-damage-is-calculated/" class="text-sm text-forest-600 underline decoration-forest-500/50 underline-offset-4 transition-colors hover:text-forest-700">Read the full breakdown &rarr;</a>
    </div>
  </section>

  <!-- ============ Featured characters (official art) ============ -->
  <section id="featured" class="page-shell section-pad scroll-mt-20 border-t border-[var(--line)]">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-forest-600">Official character art</p>
        <h2 class="mt-2 text-3xl font-semibold tracking-tight text-[var(--text)]">Featured carries</h2>
        <p class="mt-3 max-w-[65ch] text-[var(--muted)]">
          Every character in the roster has a reference panel. Start with one of these — official art, all seven elements, one calculator.
        </p>
      </div>
    </div>
    <div class="mt-8 grid grid-cols-2 gap-4 md:grid-cols-4">
      {FEATURED_CHARACTERS.map((c) => (
        <a href="#calculator" class="panel group overflow-hidden transition-colors hover:border-forest-500">
          <div class="relative aspect-[2/1] overflow-hidden">
            <img
              src={`/images/official/${c.id}-450.webp`}
              srcset={`/images/official/${c.id}-450.webp 450w, /images/official/${c.id}-540.webp 540w, /images/official/${c.id}-720.webp 720w, /images/official/${c.id}.webp 900w`}
              sizes="(min-width: 768px) 300px, 46vw"
              alt={`Official ${c.name} splash art — ${ELEMENT_LABEL[c.element]} ${c.role}`}
              width="900"
              height="450"
              class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute inset-x-0 bottom-0 bg-linear-to-t from-[#FFFBE7]/95 via-[#FFFBE7]/55 to-transparent px-3 pb-2.5 pt-10">
              <p class="flex items-center gap-1.5 font-semibold text-[var(--text)]">
                <img src={`/images/element-${c.element}.webp`} alt="" width="120" height="120" class="h-4 w-4 rounded-full bg-white object-contain p-px shadow-sm ring-1 ring-black/5" loading="lazy" decoding="async" aria-hidden="true" />
                {c.name}
              </p>
              <p class="text-xs text-[var(--muted)]">{c.role}</p>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- ============ Official videos ============ -->
  <section id="videos" class="page-shell section-pad scroll-mt-20 border-t border-[var(--line)]">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-forest-600">Official media</p>
        <h2 class="mt-2 text-3xl font-semibold tracking-tight text-[var(--text)]">Official videos</h2>
        <p class="mt-3 max-w-[65ch] text-[var(--muted)]">
          Character demos and version trailers straight from the official Genshin Impact channel.
        </p>
      </div>
    </div>
    {OFFICIAL_VIDEOS.length > 0 ? (
      <div class="mt-8 grid grid-cols-1 gap-5 md:grid-cols-3">
        {OFFICIAL_VIDEOS.map((v) => (
          <div class="panel overflow-hidden">
            <div class="aspect-video">
              <iframe
                src={`https://www.youtube-nocookie.com/embed/${v.id}`}
                title={v.title}
                loading="lazy"
                class="h-full w-full"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                referrerpolicy="strict-origin-when-cross-origin"
                allowfullscreen
              ></iframe>
            </div>
            <div class="p-4">
              <p class="text-xs font-semibold uppercase tracking-[0.18em] text-forest-600">{v.type}</p>
              <p class="mt-1 font-semibold text-[var(--text)]">{v.title}</p>
            </div>
          </div>
        ))}
      </div>
    ) : (
      <div class="panel mt-8 flex flex-col items-center gap-4 p-8 text-center">
        <span class="flex h-14 w-14 items-center justify-center rounded-2xl bg-forest-500/12 text-forest-700">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
        </span>
        <p class="text-lg font-semibold text-[var(--text)]">Character demos &amp; version trailers</p>
        <p class="max-w-[52ch] text-sm leading-relaxed text-[var(--muted)]">
          Watch official trailers, character demos and teasers on the Genshin Impact YouTube channel.
        </p>
        <a href={OFFICIAL_YOUTUBE} target="_blank" rel="noopener" class="rounded-xl bg-forest-300 px-5 py-2.5 text-sm font-semibold text-forest-900 transition-colors hover:bg-forest-200">
          Visit the official channel
        </a>
      </div>
    )}
  </section>


  <!-- ============ Features ============ -->
  <section id="features" class="page-shell section-pad scroll-mt-20 border-t border-[var(--line)]">
    <h2 class="text-3xl font-semibold tracking-tight text-[var(--text)]">Why this calculator beats the spreadsheet</h2>
    <div class="mt-8 grid grid-cols-1 gap-5 md:grid-cols-2">
      <div class="panel p-6">
        <div class="flex items-center gap-3">
          <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-forest-500/12 text-forest-600">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l2.4 7.6L22 12l-7.6 2.4L12 22l-2.4-7.6L2 12l7.6-2.4L12 2z"/></svg>
          </span>
          <h3 class="text-lg font-semibold text-[var(--text)]">Zero-input presets</h3>
        </div>
        <p class="mt-3 text-[var(--muted)]">Every character loads at level 90 with their best weapon, so you see a number before touching anything. No artifacts are counted, so every character is measured on the same footing.</p>
      </div>
      <div class="panel p-6">
        <div class="flex items-center gap-3">
          <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-hydro/15 text-hydro">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16v13H4z"/><path d="M8 7V4h8v3"/></svg>
          </span>
          <h3 class="text-lg font-semibold text-[var(--text)]">Your numbers, your call</h3>
        </div>
        <p class="mt-3 text-[var(--muted)]">Set each character’s level and weapon yourself — every field is yours to change, and the damage updates as you pick.</p>
      </div>
      <div class="panel p-6">
        <div class="flex items-center gap-3">
          <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-dendro/15 text-dendro">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M8 8l8 8M16 8l-8 8"/></svg>
          </span>
          <h3 class="text-lg font-semibold text-[var(--text)]">Weapon comparison</h3>
        </div>
        <p class="mt-3 text-[var(--muted)]">Switch weapons and watch the percentage gain live. See whether that 5-star is actually an upgrade before you spend your pulls.</p>
      </div>
      <div class="panel p-6">
        <div class="flex items-center gap-3">
          <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-electro/15 text-electro">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20V10M10 20V4M16 20v-8M22 20H2"/></svg>
          </span>
          <h3 class="text-lg font-semibold text-[var(--text)]">Six multipliers, in the open</h3>
        </div>
        <p class="mt-3 text-[var(--muted)]">Base × DMG bonus × CRIT × reaction × DEF × RES — every multiplier is its own editable zone, with the full formula chain and each zone’s contribution to the result.</p>
      </div>
    </div>
  </section>

  <!-- ============ Character presets (full roster) ============ -->
  <section id="presets" class="page-shell section-pad scroll-mt-20 border-t border-[var(--line)]">
    <h2 class="text-3xl font-semibold tracking-tight text-[var(--text)]">Reference damage for every character</h2>
    <p class="mt-3 max-w-[65ch] text-[var(--muted)]">
      Level 90, talent 10, best weapon, <strong>no artifacts</strong>, vs a level-90 enemy with 10% resistance, <strong>with no elemental reaction applied</strong> so every character is measured the same way. Each number uses the character’s highest-damage talent, named on the card. Artifacts add a large share on top of these in game, so treat them as a character’s own baseline — set a different level or weapon in the calculator above, and add reactions and buffs there too.
    </p>

    {presetByElement.map((group) => (
      <div class="mt-10">
        <h3 class="flex items-center gap-3 text-xl font-semibold tracking-tight text-[var(--text)]">
          <img
            src={`/images/element-${group.element}.webp`}
            alt={`${ELEMENT_LABEL[group.element]} element icon`}
            width="120"
            height="120"
            class="h-9 w-9 shrink-0 rounded-lg bg-white object-contain p-1 ring-1 ring-[var(--line)]"
            loading="lazy"
            decoding="async"
          />
          {ELEMENT_LABEL[group.element]} characters
          <span class="text-sm font-normal text-[var(--muted)]">({group.rows.length})</span>
        </h3>
        <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {group.rows.map(({ character, weapon, expected, critRate, critDMG }) => (
            <a href="#calculator" class="panel group p-5 transition-colors hover:border-forest-500">
              <div class="flex items-center gap-3">
                <img
                  src={`/images/portraits/${character.id}.webp`}
                  alt={`Official ${character.name} portrait`}
                  width="128"
                  height="128"
                  class="h-12 w-12 shrink-0 rounded-lg object-cover ring-1 ring-[var(--line)]"
                  loading="lazy"
                  decoding="async"
                />
                <div class="min-w-0 flex-1">
                  <p class="truncate font-semibold text-[var(--text)]">{character.name}</p>
                  <p class="flex items-center gap-2 text-xs text-[var(--muted)]">
                    <img src={`/images/element-${character.element}.webp`} alt="" width="120" height="120" class="h-4 w-4 rounded-full bg-white object-contain p-px shadow-sm ring-1 ring-black/5" loading="lazy" decoding="async" aria-hidden="true" />
                    {ELEMENT_LABEL[character.element]} · <span class="tracking-tight text-forest-600">{'★'.repeat(character.rarity)}</span>
                  </p>
                </div>
              </div>
              <p class="tnum mt-4 text-2xl font-semibold tracking-tight text-forest-600">{formatNumber(expected)}</p>
              <p class="text-xs text-[var(--muted)]">expected damage, no reaction</p>
              <p class="mt-2 text-xs leading-relaxed text-[var(--muted)]">{character.note}</p>
              <div class="mt-3 flex flex-wrap gap-x-4 gap-y-1 border-t border-[var(--line)] pt-3 text-xs text-[var(--muted)]">
                <span>CR {formatPercent(critRate)}</span>
                <span>CD {formatPercent(critDMG)}</span>
                <span class="truncate">{weapon.name}</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    ))}
  </section>

  <!-- ============ Guides hub ============ -->
  <section id="guides" class="page-shell section-pad scroll-mt-20 border-t border-[var(--line)]">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-forest-600">Deep dives</p>
        <h2 class="mt-2 text-3xl font-semibold tracking-tight text-[var(--text)]">Guides, by topic</h2>
        <p class="mt-3 max-w-[65ch] text-[var(--muted)]">
          The full mechanics breakdowns live on dedicated pages — formula and reactions, build choices, and how to
          raise damage. Each is written answer-first and cites its sources.
        </p>
      </div>
    </div>
    <div class="mt-8 grid grid-cols-1 gap-4 md:grid-cols-3">
      <a href="/guides/damage-formula/" class="panel group p-6 transition-colors hover:border-forest-500">
        <h3 class="font-semibold text-[var(--text)]">Damage formula &amp; reactions</h3>
        <p class="mt-2 text-sm leading-relaxed text-[var(--muted)]">
          The five-multiplier chain, Vaporize ×1.5 / Melt ×2.0 coefficients, EM scaling, and DEF/RES math — with
          worked examples.
        </p>
        <span class="mt-3 inline-block text-sm font-semibold text-forest-600">Read the guide →</span>
      </a>
      <a href="/guides/builds/" class="panel group p-6 transition-colors hover:border-forest-500">
        <h3 class="font-semibold text-[var(--text)]">Weapon, artifact &amp; talent builds</h3>
        <p class="mt-2 text-sm leading-relaxed text-[var(--muted)]">
          Rankings by computed damage impact, artifact set and main-stat picks, constellation value tiers, and
          talent priority.
        </p>
        <span class="mt-3 inline-block text-sm font-semibold text-forest-600">Read the guide →</span>
      </a>
      <a href="/guides/improve-damage/" class="panel group p-6 transition-colors hover:border-forest-500">
        <h3 class="font-semibold text-[var(--text)]">Increase damage &amp; fix mistakes</h3>
        <p class="mt-2 text-sm leading-relaxed text-[var(--muted)]">
          Buffs ranked by real multiplier impact, team buff setups, and the build mistakes that silently waste DPS.
        </p>
        <span class="mt-3 inline-block text-sm font-semibold text-forest-600">Read the guide →</span>
      </a>
    </div>
  </section>

  <!-- ============ Guide ============ -->
  <section id="guide" class="page-shell section-pad scroll-mt-20 border-t border-[var(--line)]">
    <h2 class="text-3xl font-semibold tracking-tight text-[var(--text)]">How to use the calculator</h2>
    <ol class="mt-8 grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
      <li class="panel p-5">
        <span class="tnum text-2xl font-semibold text-forest-500/70">01</span>
        <h3 class="mt-2 font-semibold text-[var(--text)]">Pick a character</h3>
        <p class="mt-2 text-sm text-[var(--muted)]">Open the roster and search or filter by element. The character loads at level 90 with their best weapon; add artifact stats if you want a fuller panel.</p>
      </li>
      <li class="panel p-5">
        <span class="tnum text-2xl font-semibold text-forest-500/70">02</span>
        <h3 class="mt-2 font-semibold text-[var(--text)]">The six multipliers</h3>
        <p class="mt-2 text-sm text-[var(--muted)]">Base, DMG bonus, CRIT, reaction, enemy DEF and enemy RES — the damage formula laid out as six editable zones.</p>
      </li>
      <li class="panel p-5">
        <span class="tnum text-2xl font-semibold text-forest-500/70">03</span>
        <h3 class="mt-2 font-semibold text-[var(--text)]">Damage updates live</h3>
        <p class="mt-2 text-sm text-[var(--muted)]">There is no Calculate button. The result, the formula chain and every zone’s contribution update as you type.</p>
      </li>
      <li class="panel p-5">
        <span class="tnum text-2xl font-semibold text-forest-500/70">04</span>
        <h3 class="mt-2 font-semibold text-[var(--text)]">Change one thing</h3>
        <p class="mt-2 text-sm text-[var(--muted)]">Edit a single field and watch its multiplier — and the final number — move. That is the answer to “what is this stat worth?”.</p>
      </li>
      <li class="panel p-5">
        <span class="tnum text-2xl font-semibold text-forest-500/70">05</span>
        <h3 class="mt-2 font-semibold text-[var(--text)]">Share the exact setup</h3>
        <p class="mt-2 text-sm text-[var(--muted)]">Only the fields you changed are written to the URL — copy the link and the whole setup restores on a new page.</p>
      </li>
      <li class="panel p-5">
        <span class="tnum text-2xl font-semibold text-forest-500/70">06</span>
        <h3 class="mt-2 font-semibold text-[var(--text)]">Check the reference table</h3>
        <p class="mt-2 text-sm text-[var(--muted)]">Every character’s whiteboard number, measured the same way with no reaction, is listed further down the page.</p>
      </li>
    </ol>
  </section>

  <!-- ============ Updates ============ -->
  <section id="updates" class="page-shell section-pad scroll-mt-20 border-t border-[var(--line)]">
    <h2 class="text-3xl font-semibold tracking-tight text-[var(--text)]">Data &amp; updates</h2>
    <p class="mt-3 max-w-[65ch] text-[var(--muted)]">
