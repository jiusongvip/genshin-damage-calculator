---
import BaseLayout from '../layouts/BaseLayout.astro';

const siteURL = 'https://www.genshindamagecalculator.com';
const canonicalURL = `${siteURL}/silver-light/`;

const title = 'Silver Light — Genshin Impact Event Sword: Stats, Best Characters & Comparisons';
const description =
  'Silver Light is the free 4-star event sword in Genshin Impact: 510 Base ATK, an ATK% sub-stat and a stacking Elemental Mastery passive. Its best users are the Stellar-reaction sword characters — Vesna, Odette and Cryo Traveler — whose damage scales with ATK and EM — see its tier, the character list and how it compares to New Bough, Emberwell, Finale of the Deep and Lion\u2019s Roar.';

const passive = {
  name: 'Radiance on the Water',
  effect:
    'After using an Elemental Skill, the wielder gains 52 Elemental Mastery for 12s (R1). Stacks up to 2 times; each stack has its own timer.',
};

// Headline numbers for the hero. Max EM is the total with both stacks up
// (2 × 52 at R1; the per-stack value doubles by R5), so readers don't have to
// multiply a per-stack figure themselves.
const stats = [
  { label: 'Base ATK', value: '510', note: 'Lv. 90' },
  { label: 'Sub-stat', value: 'ATK 41.3%', note: 'Lv. 90' },
  { label: 'Max EM', value: '+104', note: 'R1 · +208 at R5' },
  { label: 'Uptime', value: '2 stacks', note: '12s each, on Skill' },
];

// Recommended characters — from the 7.1 weapon guides. This is qualitative
// tiering, not a computed score: our calculator does not yet model the 7.x
// Stellar reactions, so the Stellar users below cannot be reproduced in the
// damage engine the way an Aggravate carry (Keqing) can.
type Tier = {
  key: string;
  title: string;
  subtitle: string;
  chars?: { id: string; name: string; reason: string; team?: string }[];
  prose?: string;
};

const tiers: Tier[] = [
  {
    key: 'core',
    title: 'Core fit',
    subtitle: 'Uses every part of the weapon and is one of its better 4\u2605 choices.',
    chars: [
      {
        id: 'vesna',
        name: 'Vesna',
        reason:
          'An Anemo sword on-field DPS whose damage runs through Stellar Swirl, which scales with both ATK and Elemental Mastery — so the ATK% sub-stat and the stacking EM passive both count. Her signature Beyond the Chrysalis is still well ahead; Silver Light is a free stand-in.',
      },
      {
        id: 'odette',
        name: 'Odette',
        reason:
          'A Cryo sword off-field Stellar Glimmer damage dealer and support: her Skill clone deals Stellar damage that scales with ATK and EM, so both halves of the weapon apply. In testing it ranks just behind an R2 New Bough and one other sword, not above them.',
      },
      {
        id: 'aether',
        name: 'Cryo Traveler',
        reason:
          'Deals Stellar Swirl damage through their Enhanced Charged Attack and Burst, so the ATK% and EM both apply — and Silver Light is a no-pull upgrade over their usual craftable swords.',
      },
    ],
  },
  {
    key: 'conditional',
    title: 'Conditional fit',
    subtitle: 'The effect applies, but only in specific teams or play patterns.',
    chars: [
      {
        id: 'keqing',
        name: 'Keqing',
        team: 'Aggravate',
        reason:
          'Her Elemental Skill cooldown is shorter than the EM-stack duration, so she holds both stacks up permanently \u2014 but this only pays off in an Aggravate team with a Dendro ally keeping Electro aura alive. The weapon gives no CRIT, so it demands strong CRIT substats from artifacts. Physical and pure-Electro builds get little from it.',
      },
    ],
  },
  {
    key: 'stopgap',
    title: 'Stopgap',
    subtitle: 'Better than nothing until you have a tuned weapon.',
    prose:
      'Other sword DPS who cast their Elemental Skill a lot still gain the ATK% sub-stat and some of the stacking EM, so Silver Light is a reasonable stand-in when there is no better 4\u2605 on hand. It is not, however, the intended best-in-slot for these carries.',
  },
];

// Hero "who is it for" rows, taken straight from the tiers above: core fits
// work in any team, conditional fits only in the team named by `team`.
const fitRows = [
  { label: 'Any team', chars: tiers[0].chars! },
  { label: 'Team-specific', chars: tiers[1].chars! },
];

// Where Silver Light sits among 4★ swords for its core users (Stellar
// sword characters). Stats and passives are from HoYoWiki; the order and
// verdicts summarise the 7.1 guide comparisons (Vesna / Odette testing) —
// qualitative, not computed by our engine (it does not model Stellar yet).
// `vs` is relative to Silver Light: up = stronger, even = about the same,
// self = this weapon, off = a different use case.
const tier = {
  grade: 'A',
  label: 'A top free 4★ for Stellar sword users',
  summary:
    'A refined New Bough or an R5 Emberwell edges it out, Finale of the Deep is roughly level, and generic ATK sticks fall behind. Its real edge is how easy it is to run: it only needs a Skill cast — no reaction ownership and no healer.',
};

type Vs = 'up' | 'even' | 'self' | 'off';
const swords: { id: string; name: string; source: string; atk: number; sub: string; passive: string; vs: Vs; verdict: string }[] = [
  {
    id: 'new-bough',
    name: 'New Bough',
    source: 'Event wish · 7.1',
    atk: 510,
    sub: 'CRIT DMG 55.1%',
    passive: 'Hitting within 12s of a Skill: ATK +4% and EM +20 per stack, up to 3',
    vs: 'up',
    verdict: 'Best 4★ for Stellar users, but gacha-only',
  },
  {
    id: 'emberwell',
    name: 'Emberwell',
    source: 'Forged · 7.0',
    atk: 510,
    sub: 'EM 165',
    passive: 'Any reaction: ATK +16%; Stellar Glimmer DMG +16%',
    vs: 'up',
    verdict: 'Slightly ahead at R5 — if the wielder triggers the reactions',
  },
  {
    id: 'silver-light',
    name: 'Silver Light',
    source: 'Free event · 7.1',
    atk: 510,
    sub: 'ATK 41.3%',
    passive: 'After Skill use: EM +52 per stack, up to 2',
    vs: 'self',
    verdict: 'Only needs a Skill cast to stay online',
  },
  {
    id: 'finale-of-the-deep',
    name: 'Finale of the Deep',
    source: 'Forged · Fontaine',
    atk: 565,
    sub: 'ATK 27.6%',
    passive: 'ATK buff that needs a healer to clear its Bond of Life',
    vs: 'even',
    verdict: 'Ahead only with a healer clearing its Bond of Life',
  },
  {
    id: 'lions-roar',
    name: 'Lion\u2019s Roar',
    source: 'Forged · Liyue',
    atk: 510,
    sub: 'ATK 41.3%',
    passive: 'DMG +20% vs Pyro/Electro-affected enemies',
    vs: 'off',
    verdict: 'Aggravate pick (Keqing); nothing for Stellar teams',
  },
];

const vsBadge: Record<Vs, { text: string; cls: string }> = {
  up: { text: 'Stronger', cls: 'bg-amber-100 text-amber-800' },
  even: { text: 'About even', cls: 'bg-sky-100 text-sky-800' },
  self: { text: 'This weapon', cls: 'bg-forest-300 text-forest-900' },
  off: { text: 'Different use', cls: 'bg-violet-100 text-violet-700' },
};

const faqs = [
  {
    q: 'Is Silver Light a good weapon (the new event sword)?',
    a: 'Silver Light is the free 4-star event sword: 510 base ATK, an ATK% secondary (about 41% at level 90), and a passive that grants Elemental Mastery each time you use your Elemental Skill — up to two stacks, roughly doubling from R1 to R5 for about 208 EM at R5. Its standout users are the Stellar-reaction sword characters (Vesna, Odette, Cryo Traveler), whose Stellar damage scales off both ATK and EM, so both halves of the kit apply at once; Aggravate sword DPS such as Keqing are the main conditional fit, where the EM feeds the reaction only if a Dendro ally keeps the aura up. On a character who triggers no EM-scaling reaction, the EM half is wasted and it becomes a plain, merely solid ATK% stick. As always the deciding factor is your character’s reaction, not the weapon’s rarity. One caveat: our calculator does not model the 7.x Stellar reactions yet, so Stellar pairings are not directly comparable in the tool the way an Aggravate build is.',
  },
  {
    q: 'Is Silver Light good for Keqing?',
    a: 'It is a conditional fit, not an automatic BiS. Keqing is an Electro sword DPS who plays Aggravate in most modern teams, and there the ATK% sub feeds her base damage while the stacking EM raises her Aggravate flat bonus — and because her Elemental Skill cooldown is shorter than the EM-stack duration, she holds both stacks up permanently. But that value only exists in an Aggravate team with a Dendro ally keeping the Electro aura alive; on Physical or pure-Electro sets the EM is dead weight. Silver Light also grants no CRIT, so it leans harder on your artifacts for CRIT Rate and DMG. For Aggravate Keqing it is one of the better free options and sits near Mistsplitter Reforged, but a fully refined 5-star CRIT weapon still has the higher ceiling. Load Keqing in the calculator and swap between Silver Light, Lion\u2019s Roar and Mistsplitter — the winner depends on how much EM your artifacts already provide.',
  },
  {
    q: 'Is Silver Light good on Clorinde?',
    a: 'A solid conditional fit, on the same reasoning as Keqing. Clorinde is an Aggravate/Quicken sword DPS with a CRIT Rate ascension, so ATK% plus EM both apply in those teams, and it is a strong free alternative to her signature Absolution — especially at R5 where the roughly 208 EM raises her Quicken damage. She is not, however, a headline user the way the Stellar-reaction characters are, and because Silver Light gives no CRIT she still leans on artifacts for CRIT DMG. Compare Silver Light against Absolution and Lion\u2019s Roar in the calculator using your real CRIT ratio to see the actual gap.',
  },
  {
    q: 'Is Silver Light good on Odette?',
    a: 'Yes — she is one of its core users, and this is where the old "EM is wasted on a Cryo character" reasoning breaks down. Odette is a 5-star Cryo sword character who deals Stellar Glimmer damage off-field through her Skill clone, and that damage scales off both ATK and Elemental Mastery, so Silver Light\u2019s ATK% sub and stacking EM both count rather than one half sitting idle. In testing it ranks just behind an R2 New Bough and one other sword, so it is a top free option rather than an outright BiS. The honest caveat: our calculator does not yet model the Stellar reactions, so you cannot reproduce those exact numbers in the tool the way you can for an Aggravate carry — treat this recommendation as guide-based, not a computed figure.',
  },
  {
    q: 'Silver Light or Aquila Favonia \u2014 which is better?',
    a: 'It depends entirely on whether your character benefits from Elemental Mastery. Aquila Favonia is a 5-star with a very high 674 base ATK but a Physical DMG% secondary that contributes nothing to elemental damage, so on most elemental sword DPS its only real value is that big base ATK. Silver Light trades base ATK (510) for an ATK% sub plus stacking EM. On an Aggravate character like Keqing or Clorinde, Silver Light usually wins because both the EM and the ATK% apply; on a pure ATK/CRIT elemental DPS who triggers no EM-scaling reaction, Aquila\u2019s base ATK is often equal or better. Run both through the calculator on your specific character and build \u2014 the higher number is the answer.',
  },
  {
    q: 'Silver Light vs Lion\u2019s Roar for Aggravate?',
    a: 'Both are 510-base, ATK%-sub swords, so it comes down to the passives. Lion\u2019s Roar adds a flat DMG bonus against enemies affected by Pyro or Electro (about 20% at R1 up to 36% at R5); in an Aggravate team the enemy is almost always Electro-affected, so that bonus is reliably active and lands in the separate DMG-bonus multiplier. Silver Light instead stacks EM, which raises the Aggravate flat add. At equal refinement they are very close \u2014 Lion\u2019s Roar tends to win when you keep the aura up and already have EM elsewhere, while Silver Light at R5 wins if your build is EM-starved. Test both on Keqing or Clorinde in the calculator with your actual artifacts.',
  },
  {
    q: 'Silver Light, Emberwell, or Finale of the Deep?',
    a: 'For Stellar sword users the three are close. Emberwell (forged, 510 base, 165 EM) adds 16% ATK after any reaction plus 16% Stellar Glimmer DMG, and at R5 it edges out an R5 Silver Light \u2014 but only when the wielder triggers those reactions herself. Finale of the Deep (forged, 565 base, ATK 27.6%) is about level, pulling ahead only when a healer clears its Bond of Life. Silver Light (free event, 510 base, ATK 41.3%, up to 104 EM at R1 and 208 at R5) is the easiest to run: one Skill cast keeps it online. The strongest 4-star of the group is the gacha-only New Bough. On an Aggravate carry such as Keqing, Silver Light\u2019s ATK% plus EM generally beats both Emberwell and Finale.',
  },
  {
    q: 'Is Silver Light in this calculator\u2019s weapon list yet?',
    a: 'Silver Light is a recent event weapon, so if it is not in the weapon dropdown yet it will arrive with the next data refresh \u2014 roster data is updated within 48 hours of each patch. In the meantime you can approximate it: pick any 510-base, ATK%-sub sword (Lion\u2019s Roar and Kagotsurube Isshin share that exact frame) and manually add the EM its passive grants to your Elemental Mastery total, up to about 208 at R5. If a weapon or character you own is missing, report it on the contact page and it will be added.',
  },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteURL}/` },
      { '@type': 'ListItem', position: 2, name: 'Silver Light', item: canonicalURL },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout title={title} description={description} canonicalURL={canonicalURL} schema={schema}>
  <!-- ============ Hero (sword · pitch · numbers — one compact band) ============ -->
  <section class="page-shell pt-6 md:pt-8">
    <div
      class="relative mx-auto max-w-[900px] overflow-hidden rounded-3xl border border-forest-200 bg-linear-to-br from-cryo/10 via-[#F3FBFF] to-forest-50 px-5 py-6 shadow-sm md:px-8 md:py-7"
    >
      <div class="grid items-center gap-6 md:grid-cols-[56px_minmax(0,1fr)_280px] md:gap-6">
        <!-- sword art (desktop only; mobile shows it inside the numbers card) -->
        <div class="relative hidden justify-center md:flex">
          <div class="pointer-events-none absolute inset-0 m-auto h-32 w-32 rounded-full bg-cryo/25 blur-3xl" aria-hidden="true"></div>
          <img
            src="/images/weapons/silver-light-hero.webp"
            alt="Official Silver Light sword art"
            width="512"
            height="1024"
            fetchpriority="high"
            decoding="async"
            class="relative h-52 w-auto max-w-none -rotate-3 drop-shadow-xl"
          />
        </div>

        <!-- pitch -->
        <div class="min-w-0">
          <p class="flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.18em] text-forest-700">
            <img src="/images/weapons/silver-light.webp" alt="" width="128" height="128" class="h-4 w-4 rounded bg-white/90 object-contain p-0.5 shadow-sm ring-1 ring-black/5" aria-hidden="true" />
            Free 4&#9733; Event Sword · Version 7.1
            <a href="#compare" class="ml-1 rounded-full bg-forest-300 px-2 py-0.5 text-[0.65rem] tracking-[0.08em] text-forest-900 hover:bg-forest-200">Tier {tier.grade}</a>
          </p>

          <h1 class="mt-1.5 font-display text-4xl font-semibold leading-[1.05] tracking-tight text-forest-900 md:text-5xl">Silver Light</h1>

          <p class="mt-3 text-base leading-relaxed text-[var(--muted)] md:text-[1.05rem]">
            An <strong class="font-semibold text-[var(--text)]">ATK% sub-stat</strong> plus a <strong class="font-semibold text-[var(--text)]">stacking Elemental Mastery</strong> passive &mdash; strongest on <strong class="font-semibold text-[var(--text)]">Stellar-reaction</strong> sword users, whose damage scales with both stats.
          </p>

          <dl class="mt-4 space-y-2.5">
            {fitRows.map((row) => (
              <div>
                <dt class="text-[0.68rem] font-semibold uppercase tracking-[0.1em] text-forest-600">{row.label}</dt>
                <dd class="mt-1 flex flex-wrap gap-2">
                  {row.chars.map((c) => (
                    <a href="#recommended" class="flex items-center gap-1.5 rounded-full border border-forest-200 bg-white/70 py-1 pl-1 pr-3 transition-colors hover:border-forest-300 hover:bg-white">
                      <span class="flex h-7 w-7 shrink-0 items-center justify-center overflow-hidden rounded-full bg-forest-100 font-display text-sm font-semibold text-forest-700 ring-1 ring-forest-300">
                        <img src={`/images/portraits/${c.id}.webp`} alt="" width="256" height="256" decoding="async" class="h-full w-full object-cover" />
                      </span>
                      <span class="text-sm font-medium text-forest-900">{c.name}</span>
                      {c.team && <span class="rounded-full bg-violet-100 px-2 py-0.5 text-[0.65rem] font-semibold text-violet-700">{c.team} only</span>}
                    </a>
                  ))}
                </dd>
              </div>
            ))}
          </dl>

          <div class="mt-5 flex flex-wrap gap-2.5">
            <a href="/#calculator" class="rounded-xl bg-forest-300 px-4 py-2 text-sm font-semibold text-forest-900 transition-colors hover:bg-forest-200">Open the calculator</a>
            <a href="#recommended" class="rounded-xl border border-forest-300 px-4 py-2 text-sm font-semibold text-forest-700 transition-colors hover:bg-forest-50">Who should use it</a>
          </div>
        </div>

        <!-- numbers -->
        <div class="flex items-center gap-3">
          <img
            src="/images/weapons/silver-light-hero.webp"
            alt=""
            width="512"
            height="1024"
            decoding="async"
            class="h-36 w-auto max-w-none -rotate-3 drop-shadow-lg md:hidden"
            aria-hidden="true"
          />
          <div class="min-w-0 flex-1 rounded-2xl border border-forest-200 bg-white/80 px-4 py-4 backdrop-blur-sm md:px-5">
            <dl class="grid grid-cols-2 gap-x-4 gap-y-4">
              {stats.map((s) => (
                <div class="min-w-0">
                  <dt class="text-xs font-semibold uppercase tracking-[0.06em] text-forest-600">{s.label}</dt>
                  <dd class="mt-0.5 whitespace-nowrap text-xl font-semibold leading-tight tabular-nums text-forest-900">{s.value}</dd>
                  <dd class="mt-0.5 text-xs leading-tight text-[var(--muted)]">{s.note}</dd>
                </div>
              ))}
            </dl>
            <p class="mt-4 border-t border-forest-200/70 pt-3 text-sm leading-relaxed text-[var(--muted)]">
              <span class="font-semibold text-[var(--text)]">{passive.name}:</span> {passive.effect}
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ Rating + 4-star comparison ============ -->
  <section id="compare" class="page-shell pt-10 md:pt-12 scroll-mt-24">
    <div class="mx-auto max-w-[900px]">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-forest-600">How good is it?</p>
      <h2 class="mt-2 text-3xl font-semibold tracking-tight text-[var(--text)]">Silver Light vs other 4&#9733; swords</h2>

      <div class="mt-5 flex items-start gap-4 rounded-2xl border border-forest-200 bg-white/70 p-4 md:p-5">
        <span class="flex h-14 w-14 shrink-0 items-center justify-center rounded-xl bg-forest-300 font-display text-3xl font-semibold text-forest-900" aria-label={`Tier ${tier.grade}`}>{tier.grade}</span>
        <div class="min-w-0">
          <p class="font-semibold text-[var(--text)]">{tier.label}</p>
          <p class="mt-1 text-sm leading-relaxed text-[var(--muted)]">{tier.summary}</p>
        </div>
      </div>

      <div class="mt-4 overflow-x-auto rounded-2xl border border-forest-200">
        <table class="w-full min-w-[720px] border-collapse text-left text-sm">
          <thead class="bg-forest-50 text-xs font-semibold uppercase tracking-[0.06em] text-forest-600">
            <tr>
              <th scope="col" class="w-[190px] px-4 py-2.5">Sword</th>
              <th scope="col" class="whitespace-nowrap px-3 py-2.5">Base ATK</th>
              <th scope="col" class="px-3 py-2.5">Sub-stat</th>
              <th scope="col" class="px-3 py-2.5">Passive (R1)</th>
              <th scope="col" class="px-4 py-2.5">vs Silver Light</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-forest-200/70">
            {swords.map((w) => (
              <tr class={w.vs === 'self' ? 'bg-cryo/10' : 'bg-white/60'}>
                <th scope="row" class="px-4 py-3 font-normal">
                  <div class="flex items-center gap-2.5">
                    <img src={`/images/weapons/${w.id}.webp`} alt="" width="128" height="128" loading="lazy" decoding="async" class="h-9 w-9 shrink-0 rounded-lg bg-white object-contain p-0.5 ring-1 ring-forest-200" />
                    <div class="min-w-0">
                      <p class="whitespace-nowrap font-semibold text-[var(--text)]">{w.name}</p>
                      <p class="whitespace-nowrap text-xs text-[var(--muted)]">{w.source}</p>
                    </div>
                  </div>
                </th>
                <td class="px-3 py-3 tabular-nums text-[var(--text)]">{w.atk}</td>
                <td class="whitespace-nowrap px-3 py-3 text-[var(--text)]">{w.sub}</td>
                <td class="px-3 py-3 text-[var(--muted)]">{w.passive}</td>
                <td class="px-4 py-3">
                  <span class={`inline-block rounded-full px-2 py-0.5 text-[0.7rem] font-semibold ${vsBadge[w.vs].cls}`}>{vsBadge[w.vs].text}</span>
                  <p class="mt-1 text-xs leading-snug text-[var(--muted)]">{w.verdict}</p>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mt-2 text-xs text-[var(--muted)]">Order and verdicts summarise the 7.1 guide tests on Vesna and Odette; stats and passives are from HoYoWiki. Swap weapons in the <a href="/#calculator" class="text-forest-600 underline underline-offset-4">calculator</a> for your own build.</p>
    </div>
  </section>

  <!-- ============ What it is ============ -->
  <section class="page-shell section-pad">
    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-forest-600">The weapon</p>
    <h2 class="mt-2 text-3xl font-semibold tracking-tight text-[var(--text)]">What Silver Light does</h2>
    <p class="mt-4 max-w-[70ch] leading-relaxed text-[var(--muted)]">
      At level 90 Silver Light provides <strong class="text-[var(--text)]">510 Base ATK</strong> and an
      <strong class="text-[var(--text)]">ATK% secondary</strong> (about 41%). Its passive grants
      <strong class="text-[var(--text)]">Elemental Mastery</strong> for 12s each time the wielder uses their Elemental
      Skill, stacking up to two times; the amount roughly doubles from R1 to R5, reaching about
      <strong class="text-[var(--text)]">208 EM at R5</strong> with both stacks up. That combination &mdash; ATK% for the base
      hit plus EM for the reaction &mdash; is what makes it a standout free option, but only on characters whose reactions
      actually consume EM: the new <strong class="text-[var(--text)]">Stellar</strong> reactions scale with both stats,
      which is why the Stellar sword users below are its core fits.
    </p>

    <p class="mt-4 rounded-lg border border-amber-200 bg-amber-50/70 px-4 py-3 text-sm leading-relaxed text-[var(--muted)]">
      <strong class="text-[var(--text)]">Heads up:</strong> this tier list is qualitative and drawn from the version 7.1 weapon
      guides, so it may reflect subjective ranking. Our damage calculator does not model the 7.x <em>Stellar</em> reactions yet,
      so the Stellar users cannot be reproduced as a computed number the way an Aggravate carry (Keqing) can.
    </p>
  </section>

  <!-- ============ Recommended characters (tiered) ============ -->
  <section id="recommended" class="page-shell section-pad scroll-mt-24 border-t border-[var(--line)]">
    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-forest-600">Recommended characters</p>
    <h2 class="mt-2 text-3xl font-semibold tracking-tight text-[var(--text)]">Who should run Silver Light</h2>

    <div class="mt-8 space-y-8">
      {tiers.map((tier) => (
        <div>
          <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
            <h3 class="font-display text-xl font-semibold text-forest-800">{tier.title}</h3>
            <p class="text-sm text-[var(--muted)]">{tier.subtitle}</p>
          </div>

          {tier.chars && (
            <ul class="mt-4 space-y-4">
              {tier.chars.map((c) => (
                <li class="panel flex gap-4 p-5">
                  <span class="flex h-14 w-14 shrink-0 items-center justify-center overflow-hidden rounded-full bg-forest-100 font-display text-2xl font-semibold text-forest-700 ring-2 ring-forest-300">
                    <img src={`/images/portraits/${c.id}.webp`} alt={`${c.name} portrait`} width="256" height="256" loading="lazy" decoding="async" class="h-full w-full object-cover" />
                  </span>
                  <div class="min-w-0">
                    <p class="flex flex-wrap items-center gap-2 font-display text-base font-semibold text-[var(--text)]">
                      {c.name}
                      {c.team && (
                        <span class="rounded-full bg-violet-100 px-2 py-0.5 text-[0.65rem] font-medium uppercase tracking-wide text-violet-700">{c.team} team</span>
                      )}
                    </p>
                    <p class="mt-1 text-sm leading-relaxed text-[var(--muted)]">{c.reason}</p>
                  </div>
                </li>
              ))}
            </ul>
          )}

          {tier.prose && <p class="mt-3 max-w-[72ch] text-sm leading-relaxed text-[var(--muted)]">{tier.prose}</p>}
        </div>
      ))}
    </div>
  </section>

  <!-- ============ CTA ============ -->
  <section class="page-shell section-pad border-t border-[var(--line)]">
    <div class="flex flex-wrap items-center justify-between gap-4">
      <div>
        <h2 class="text-2xl font-semibold tracking-tight text-[var(--text)]">Check it on your own build</h2>
        <p class="mt-2 max-w-[65ch] text-[var(--muted)]">
          Rarity never decides a weapon &mdash; the computed number does. Set your character, artifacts and buffs, then swap
          Silver Light in and out to see the exact gain.
        </p>
      </div>
      <a href="/#calculator"
        class="rounded-xl bg-forest-300 px-5 py-2.5 text-center text-sm font-semibold text-forest-900 transition-colors hover:bg-forest-200">
        Open the damage calculator
      </a>
    </div>
  </section>

  <!-- ============ FAQ ============ -->
  <section id="faq" class="page-shell section-pad scroll-mt-20 border-t border-[var(--line)]">
    <h2 class="text-3xl font-semibold tracking-tight text-[var(--text)]">Silver Light FAQ</h2>
    <div class="mt-8 divide-y divide-[var(--line)] border-t border-[var(--line)]">
      {faqs.map((f) => (
        <details class="group">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-4 font-medium text-[var(--text)]">
            {f.q}
            <svg class="h-5 w-5 shrink-0 text-[var(--muted)] transition-transform group-open:rotate-45" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14" /></svg>
          </summary>
          <p class="max-w-[75ch] pb-4 leading-relaxed text-[var(--muted)]">{f.a}</p>
        </details>
      ))}
    </div>
  </section>
</BaseLayout>
