---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormulaSection from '../../components/FormulaSection.astro';

const siteURL = 'https://www.genshindamagecalculator.com';
const canonicalURL = `${siteURL}/how-damage-is-calculated/`;

const title = 'How Genshin Damage Is Calculated — The Official Formula Explained';
const description =
  'The seven-factor Genshin Impact damage formula explained: scaling stat, talent %, DMG bonus, CRIT, amplifying/transformative/additive reactions, DEF and RES — the exact engine behind the calculator.';

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteURL}/` },
      { '@type': 'ListItem', position: 2, name: 'How damage is calculated', item: canonicalURL },
    ],
  },
];
---

<BaseLayout title={title} description={description} canonicalURL={canonicalURL} schema={schema}>
  <section class="page-shell pt-10">
    <nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-2 text-sm text-[var(--muted)]">
      <a href="/" class="transition-colors hover:text-forest-600">Home</a>
      <span aria-hidden="true">/</span>
      <span class="text-[var(--text)]">How damage is calculated</span>
    </nav>
    <h1 class="mt-6 max-w-[24ch] text-4xl font-semibold tracking-tight text-[var(--text)] md:text-5xl">
      How Genshin damage is actually calculated
    </h1>
    <p class="mt-4 max-w-[70ch] text-lg leading-relaxed text-[var(--text)]/85">
      Every number the calculator shows is one product of six factors. Here is each factor in full — the reference behind
      the tool.
    </p>
  </section>
  <FormulaSection />
</BaseLayout>
