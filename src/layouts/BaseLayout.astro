---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BackToTop from '../components/BackToTop.astro';
import soraWoff2 from '@fontsource-variable/sora/files/sora-latin-wght-normal.woff2?url';
import cinzelWoff2 from '@fontsource-variable/cinzel/files/cinzel-latin-wght-normal.woff2?url';

export interface Props {
  title: string;
  description: string;
  canonicalURL?: string;
  ogImage?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}

const { title, description, canonicalURL, ogImage, schema, noindex } = Astro.props;

const ga4Id = 'G-H2B2594NNV';
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <link rel="preload" as="image" href="/images/official/mavuika.webp" imagesrcset="/images/official/mavuika-450.webp 450w, /images/official/mavuika-540.webp 540w, /images/official/mavuika-720.webp 720w, /images/official/mavuika.webp 900w" imagesizes="(min-width: 1024px) 510px, 62vw" fetchpriority="high" />
    <link rel="preload" as="font" type="font/woff2" href={soraWoff2} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={cinzelWoff2} crossorigin />
    <SEO
      title={title}
      description={description}
      canonicalURL={canonicalURL}
      ogImage={ogImage}
      schema={schema}
      noindex={noindex}
    />
    {
      ga4Id && (
        <script is:inline define:vars={{ ga4Id }}>
          (function () {
            var load = function () {
              window.dataLayer = window.dataLayer || [];
              function gtag() { dataLayer.push(arguments); }
              gtag('js', new Date());
              gtag('config', ga4Id);
              var s = document.createElement('script');
              s.async = true;
              s.src = 'https://www.googletagmanager.com/gtag/js?id=' + ga4Id;
              document.head.appendChild(s);
            };
            if (document.readyState === 'complete') {
              scheduleLoad();
            } else {
              window.addEventListener('load', scheduleLoad, { once: true });
            }
            function scheduleLoad() {
              if ('requestIdleCallback' in window) {
                requestIdleCallback(load, { timeout: 4000 });
              } else {
                setTimeout(load, 1500);
              }
            }
          })();
        </script>
      )
    }
  </head>
  <body class="stardust flex min-h-[100dvh] flex-col">
    <Header />
    <main id="top" class="flex-1">
      <slot />
    </main>
    <Footer />
    <BackToTop />
  </body>
</html>
