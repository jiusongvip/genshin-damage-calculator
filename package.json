{
  "name": "genshin-damage-calculator",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "npx astro build && node scripts/fix-sitemap-home.mjs",
    "preview": "astro preview",
    "lint": "astro check",
    "check:images": "node scripts/check-asset-images.mjs",
    "check:data": "node scripts/verify-baseline.mjs",
    "gen:talents": "node scripts/generate-talents.mjs",
    "gen:talents-summary": "node scripts/generate-talents-summary.mjs",
    "gen:level-stats": "node scripts/generate-level-stats.mjs",
    "gen:ascension-report": "node scripts/generate-level-stats.mjs --ascension-report > .audit/ascension-truth.json",
    "sync:characters": "node scripts/sync-character-stats.mjs",
    "gen:data": "npm run gen:level-stats && npm run gen:ascension-report && npm run sync:characters && npm run gen:talents && npm run gen:talents-summary",
    "test": "vitest run"
  },
  "dependencies": {
    "@astrojs/react": "^4.2.1",
    "@astrojs/sitemap": "^3.2.1",
    "@fontsource-variable/cinzel": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/outfit": "^5.1.1",
    "@fontsource-variable/sora": "^5.3.0",
    "@fontsource/archivo-black": "^5.3.0",
    "astro": "^5.5.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@tailwindcss/vite": "^4.0.15",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "genshin-db": "^5.2.13",
    "tailwindcss": "^4.0.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
